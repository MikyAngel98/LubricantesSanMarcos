<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Vista.MainControllers.ConfiguracionController"
      spacing="15" style="-fx-padding: 20; -fx-background-color: #f8f9fa;"
      VBox.vgrow="ALWAYS">

    <Label text="⚙️ CONFIGURACIÓN" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator/>

    <Label text="👤 USUARIOS DEL SISTEMA" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>

    <HBox spacing="10">
        <Button fx:id="btnNuevoUsuario" text="➕ NUEVO USUARIO" onAction="#abrirNuevoUsuario"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button fx:id="btnEditarUsuario" text="✏️ EDITAR" onAction="#editarUsuario"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button fx:id="btnEliminarUsuario" text="🗑️ ELIMINAR" onAction="#eliminarUsuario"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCerrar" text="🔒 CERRAR" onAction="#cerrar"
                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombreUsuario" text="Usuario" prefWidth="150"/>
            <TableColumn fx:id="colNombreCompleto" text="Nombre Completo" prefWidth="200"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="100"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="70"/>
        </columns>
    </TableView>

    <Label fx:id="lblUsuarioActual" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>

</VBox>
