<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Vista.LoginController.LoginController"
      spacing="15" style="-fx-padding: 35; -fx-background-color: #f8f9fa;"
      alignment="CENTER" prefWidth="400" prefHeight="420">

    <Label text="🔐 LUBRICANTES SAN MARCOS" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a5276;"/>
    <Label text="Iniciar Sesión" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

    <Separator/>

    <GridPane hgap="10" vgap="15">
        <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtUsuario" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220" promptText="Ingrese su usuario"/>

        <Label text="Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="txtContrasenia" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="220" promptText="Ingrese su contraseña"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnIniciarSesion" text="🔓 INICIAR SESIÓN" onAction="#iniciarSesion"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-cursor: hand;"/>
        <Button fx:id="btnCancelar" text="CANCELAR" onAction="#cancelar"
                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>
    </HBox>

    <Label fx:id="lblError" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" visible="false"/>

</VBox>