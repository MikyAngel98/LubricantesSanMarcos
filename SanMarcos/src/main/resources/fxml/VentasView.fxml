<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Vista.MainControllers.VentasController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: #f8f9fa;"
      stylesheets="@../css/ventas.css"
      VBox.vgrow="ALWAYS">

    <fx:define>
        <ToggleGroup fx:id="pagoGrupo"/>
    </fx:define>

    <Label text="🛒 PUNTO DE VENTA" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator/>

    <!-- Botones de categoría -->
    <HBox spacing="15">
        <Button fx:id="btnAceites" text="🛢️ ACEITES" onAction="#cargarAceites" styleClass="btn-aceites" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnFiltros" text="🔧 FILTROS" onAction="#cargarFiltros" styleClass="btn-filtros" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnFocos" text="💡 FOCOS" onAction="#cargarFocos" styleClass="btn-focos" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnProductos" text="📦 PRODUCTOS" onAction="#cargarProductos" styleClass="btn-productos" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtBuscar" promptText="Buscar..." styleClass="buscador" prefWidth="200"/>
    </HBox>

    <Separator/>

    <!-- Contenedor principal - 65% / 35% -->
    <HBox spacing="20" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

        <!-- COLUMNA IZQUIERDA - 65% -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" prefWidth="0">

            <Label text="PRODUCTOS:" style="-fx-font-weight: bold;"/>

            <ScrollPane fx:id="scrollTablas" VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="false" prefWidth="0">
                <StackPane fx:id="panelTablas" prefHeight="380">

                    <!-- Tabla ACEITES -->
                    <TableView fx:id="tablaAceites">
                        <columns>
                            <TableColumn fx:id="colAceiteId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colAceiteNombre" text="Nombre" prefWidth="180"/>
                            <TableColumn fx:id="colAceiteViscosidad" text="Viscosidad" prefWidth="80"/>
                            <TableColumn fx:id="colAceiteMarca" text="Marca" prefWidth="100"/>
                            <TableColumn fx:id="colAceitePrecio" text="Precio (Bs)" prefWidth="90"/>
                            <TableColumn fx:id="colAceiteStock" text="Stock" prefWidth="70"/>
                            <TableColumn fx:id="colAceitePresentacion" text="Presentación" prefWidth="100"/>
                            <TableColumn fx:id="colAceiteAgranel" text="A granel" prefWidth="70"/>
                            <TableColumn fx:id="colAceiteTipo" text="Tipo" prefWidth="100"/>
                            <TableColumn fx:id="colAceiteUso" text="Uso" prefWidth="100"/>
                            <TableColumn fx:id="colAceiteDetalle" text="Detalle" prefWidth="200"/>
                        </columns>
                    </TableView>

                    <!-- Tabla FILTROS -->
                    <TableView fx:id="tablaFiltros">
                        <columns>
                            <TableColumn fx:id="colFiltroId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colFiltroNombre" text="Nombre" prefWidth="200"/>
                            <TableColumn fx:id="colFiltroCodigo" text="Código" prefWidth="100"/>
                            <TableColumn fx:id="colFiltroRosca" text="Rosca" prefWidth="100"/>
                            <TableColumn fx:id="colFiltroMarca" text="Marca" prefWidth="100"/>
                            <TableColumn fx:id="colFiltroStock" text="Stock" prefWidth="80"/>
                            <TableColumn fx:id="colFiltroPrecio" text="Precio (Bs)" prefWidth="100"/>
                            <TableColumn fx:id="colFiltroDetalle" text="Detalle" prefWidth="200"/>
                        </columns>
                    </TableView>

                    <!-- Tabla FOCOS -->
                    <TableView fx:id="tablaFocos">
                        <columns>
                            <TableColumn fx:id="colFocoId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colFocoNombre" text="Nombre" prefWidth="200"/>
                            <TableColumn fx:id="colFocoCodigo" text="Código" prefWidth="100"/>
                            <TableColumn fx:id="colFocoMarca" text="Marca" prefWidth="100"/>
                            <TableColumn fx:id="colFocoStock" text="Stock" prefWidth="80"/>
                            <TableColumn fx:id="colFocoPrecio" text="Precio (Bs)" prefWidth="100"/>
                            <TableColumn fx:id="colFocoDetalle" text="Detalle" prefWidth="200"/>
                        </columns>
                    </TableView>

                    <!-- Tabla PRODUCTOS BASE -->
                    <TableView fx:id="tablaProductosBase">
                        <columns>
                            <TableColumn fx:id="colProdId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colProdNombre" text="Nombre" prefWidth="250"/>
                            <TableColumn fx:id="colProdMarca" text="Marca" prefWidth="120"/>
                            <TableColumn fx:id="colProdStock" text="Stock" prefWidth="80"/>
                            <TableColumn fx:id="colProdPrecio" text="Precio (Bs)" prefWidth="100"/>
                            <TableColumn fx:id="colProdDetalle" text="Detalle" prefWidth="250"/>
                        </columns>
                    </TableView>

                </StackPane>
            </ScrollPane>

            <!-- CLIENTE OPCIONAL - sin estirar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="CLIENTE (OPCIONAL):" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtClienteNombre" promptText="Nombre" prefWidth="200"/>
                <TextField fx:id="txtClienteCelular" promptText="Celular" prefWidth="150"/>
            </HBox>

            <!-- Cantidad -->
            <Label text="CANTIDAD:" style="-fx-font-weight: bold;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnDisminuir" text="-" prefWidth="40" styleClass="btn-mas-menos"/>
                <TextField fx:id="txtCantidad" text="1" prefWidth="80" styleClass="cantidad-field"/>
                <Button fx:id="btnAumentar" text="+" prefWidth="40" styleClass="btn-mas-menos"/>
                <Button fx:id="btnAgregar" text="➕ AGREGAR AL CARRITO" styleClass="btn-agregar" prefWidth="180"/>
            </HBox>

            <Label fx:id="lblProductoSeleccionado" text="" style="-fx-text-fill: #7f8c8d;"/>
        </VBox>

        <!-- COLUMNA DERECHA - 35% Carrito -->
        <VBox spacing="10" HBox.hgrow="NEVER" VBox.vgrow="ALWAYS" prefWidth="380" maxWidth="380">

            <Label text="CARRITO DE COMPRAS:" style="-fx-font-weight: bold;"/>

            <TableView fx:id="tblCarrito" VBox.vgrow="ALWAYS" prefHeight="0" prefWidth="370" maxWidth="370">
                <columns>
                    <TableColumn fx:id="colCarritoProducto" text="Producto" prefWidth="150"/>
                    <TableColumn fx:id="colCarritoMarca" text="Marca" prefWidth="80"/>
                    <TableColumn fx:id="colCarritoCantidad" text="Cantidad" prefWidth="60"/>
                    <TableColumn fx:id="colCarritoPrecio" text="Precio" prefWidth="60"/>
                    <TableColumn fx:id="colCarritoSubtotal" text="Subtotal" prefWidth="65"/>
                </columns>
            </TableView>

            <HBox spacing="10">
                <Button fx:id="btnQuitar" text="❌ QUITAR" styleClass="btn-quitar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="btnLimpiarCarrito" text="🗑️ LIMPIAR" styleClass="btn-limpiar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <Separator/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="TOTAL:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Label fx:id="lblTotal" text="Bs 0.00" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #27ae60;"/>
            </HBox>

            <Separator/>

            <Label text="MÉTODO DE PAGO:" style="-fx-font-weight: bold;"/>
            <HBox spacing="15">
                <RadioButton text="EFECTIVO" fx:id="rbEfectivo" toggleGroup="$pagoGrupo" selected="true"/>
                <RadioButton text="QR" fx:id="rbQr" toggleGroup="$pagoGrupo"/>
            </HBox>

            <Button fx:id="btnFinalizar" text="💰 FINALIZAR VENTA" maxWidth="Infinity" styleClass="btn-finalizar" HBox.hgrow="ALWAYS"/>
        </VBox>
    </HBox>

</VBox>