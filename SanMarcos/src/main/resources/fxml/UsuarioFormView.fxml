<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>

<?import java.lang.String?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Vista.MainControllers.UsuarioFormController"
      spacing="15" style="-fx-padding: 25; -fx-background-color: #f8f9fa;"
      prefWidth="420" prefHeight="420">

    <Label fx:id="lblTitulo" text="👤 NUEVO USUARIO" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator/>

    <GridPane hgap="10" vgap="12">
        <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtNombreUsuario" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" promptText="Nombre de usuario"/>

        <Label text="Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="txtContrasenia" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250" promptText="Mínimo 6 caracteres"/>

        <Label text="Confirmar:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="txtConfirmarContrasenia" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250" promptText="Confirmar contraseña"/>

        <Label text="Nombre Completo:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtNombreCompleto" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="250" promptText="Nombre y apellidos"/>

        <Label text="Rol:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="cbRol" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="250">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="ADMIN"/>
                    <String fx:value="VENDEDOR"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Label text="Activo:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <CheckBox fx:id="chkActivo" GridPane.rowIndex="5" GridPane.columnIndex="1" text="Usuario activo" selected="true"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="btnGuardar" text="GUARDAR" onAction="#guardar"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 25; -fx-cursor: hand;"/>
        <Button fx:id="btnCancelar" text="CANCELAR" onAction="#cancelar"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 25; -fx-cursor: hand;"/>
    </HBox>

</VBox>
